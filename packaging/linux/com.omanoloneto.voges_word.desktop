[Desktop Entry]
Type=Application
Name=Voges Word
GenericName=Word processor
GenericName[pt]=Editor de documentos
GenericName[pt_BR]=Editor de documentos
GenericName[es]=Procesador de textos
Comment=Edit Word and OpenDocument documents, RTF, HTML, Markdown and plain text
Comment[pt]=Edite documentos do Word e OpenDocument, RTF, HTML, Markdown e texto simples
Comment[pt_BR]=Edite documentos do Word e OpenDocument, RTF, HTML, Markdown e texto simples
Comment[es]=Edita documentos de Word y OpenDocument, RTF, HTML, Markdown y texto sin formato
Exec=voges-word %f
Icon=com.omanoloneto.voges_word
Terminal=false
Categories=Office;WordProcessor;
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.openxmlformats-officedocument.wordprocessingml.template;application/vnd.ms-word.document.macroEnabled.12;application/vnd.ms-word.template.macroEnabled.12;application/msword;application/vnd.oasis.opendocument.text;application/vnd.oasis.opendocument.text-template;application/rtf;text/rtf;text/html;application/xhtml+xml;text/markdown;text/plain;
Keywords=docx;doc;odt;rtf;word;text;document;
Keywords[pt]=docx;doc;odt;rtf;word;texto;documento;
Keywords[pt_BR]=docx;doc;odt;rtf;word;texto;documento;
Keywords[es]=docx;doc;odt;rtf;word;texto;documento;
StartupWMClass=com.omanoloneto.voges_word
