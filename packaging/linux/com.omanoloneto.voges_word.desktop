[Desktop Entry]
Type=Application
Name=Voges Word
GenericName=Word processor
GenericName[pt]=Editor de documentos
GenericName[pt_BR]=Editor de documentos
GenericName[es]=Procesador de textos
Comment=Edit Word documents (.docx) and plain text
Comment[pt]=Edite documentos do Word (.docx) e texto simples
Comment[pt_BR]=Edite documentos do Word (.docx) e texto simples
Comment[es]=Edita documentos de Word (.docx) y texto sin formato
Exec=voges-word %f
Icon=com.omanoloneto.voges_word
Terminal=false
Categories=Office;WordProcessor;
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;text/plain;
Keywords=docx;word;text;document;
Keywords[pt]=docx;word;texto;documento;
Keywords[pt_BR]=docx;word;texto;documento;
Keywords[es]=docx;word;texto;documento;
StartupWMClass=com.omanoloneto.voges_word
